<Project>

    <!--
        Gaffer.Api.Client package version (SemVer 2.0.0); override with /p:GlobalPackageVersion=<version>.
        Only Gaffer.Api.Client uses it as its <Version>; the other assemblies keep their own version.
        Gaffer.Api receives it as assembly metadata "GafferClientVersion" and publishes it as info.version
        of the "AutogeneratedClient" OpenAPI document, from which NSwag generates the client.
    -->
    <PropertyGroup>
        <GlobalPackageVersion Condition="'$(GlobalPackageVersion)' == ''">3.0.0</GlobalPackageVersion>
    </PropertyGroup>

    <ItemGroup Condition="'$(MSBuildProjectName)' == 'Gaffer.Api'">
        <AssemblyMetadata Include="GafferClientVersion" Value="$(GlobalPackageVersion)" />
    </ItemGroup>

    <Target Name="ValidateClientSemVer"
            BeforeTargets="BeforeBuild;GenerateNuspec"
            Condition="'$(MSBuildProjectName)' == 'Gaffer.Api.Client'">
        <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(Version)', '^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(-((0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*)(\.(0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(\+([0-9a-zA-Z-]+(\.[0-9a-zA-Z-]+)*))?$'))"
               Text="Gaffer.Api.Client version '$(Version)' is not a valid Semantic Version 2.0.0 (MAJOR.MINOR.PATCH[-prerelease][+build], e.g. 1.0.0). Set GlobalPackageVersion in Directory.Build.props or pass /p:GlobalPackageVersion=&lt;version&gt;." />
    </Target>

</Project>
